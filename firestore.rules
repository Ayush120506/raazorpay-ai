rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default allow for demo; restrict in production
    match /{document=**} {
      allow read, write: if true;
    }

    // Merchant Profile / Settings (authenticated owners only)
    match /merchants/{merchantId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data?.uid;
    }

    // Failed Payments & Recovery Logs
    match /failed_payments/{paymentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Recovery Call Sessions & WhatsApp Message Tracking
    match /recovery_sessions/{sessionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
